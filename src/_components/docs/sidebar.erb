<aside class="docs-sidebar" id="docs-sidebar">
  <div class="sidebar-inner">
    <% @navigation.each do |section| %>
      <div class="sidebar-section">
        <h5 class="sidebar-heading"><%= section["section"] %></h5>
        <ul class="sidebar-list">
          <% (section["items"] || []).each do |item| %>
            <li>
              <a href="<%= item["url"] %>"
                 class="sidebar-link <%= 'active' if active?(item["url"]) %>">
                <%= item["title"] %>
              </a>
              <% if item["items"] %>
                <ul class="sidebar-sublist">
                  <% item["items"].each do |sub| %>
                    <li>
                      <a href="<%= sub["url"] %>"
                         class="sidebar-link sidebar-sublink <%= 'active' if active?(sub["url"]) %>">
                        <%= sub["title"] %>
                      </a>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</aside>
